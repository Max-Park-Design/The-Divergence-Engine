# Optional overrides for unblocker_jetson.py.
# The current Jetson script reads Mistral and Brave keys from the separate
# MISTRAL_API_KEY.txt and BRAVE_SEARCH_API_KEY.txt files described in
# docs/setup-jetson.md. Do not commit either file.

# UNBLOCKER_OLLAMA_API=http://127.0.0.1:11434
# UNBLOCKER_CHAT_MODEL=granite-engine:latest
# UNBLOCKER_EMBED_MODEL=granite-embedding:30m
# UNBLOCKER_ARDUINO_PORT=/dev/ttyACM0
# UNBLOCKER_PRINTER_PORT=/dev/ttyUSB0

